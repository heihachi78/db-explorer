# Oracle metadata reader (read-only account)
ORACLE_USER=metadata_reader
ORACLE_PASSWORD=change-me
# The Compose service is reachable by this name on the shared Docker network.
ORACLE_DSN=ora-db:1521/FREEPDB1
ORACLE_MODE=thin

# Local application settings
APP_PORT=8000
APP_DATA_DIR=/data
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:5173
SCAN_MAX_SECONDS=3600
ANALYSIS_MAX_NODES=500000
ANALYSIS_MAX_EDGES=5000000
